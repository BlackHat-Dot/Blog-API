# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (Blog API)
# ==============================================================================

# [REQUIRED] Secret key used for signing JWT access tokens (minimum 32 characters recommended)
# You can generate a secure random string with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars

# [REQUIRED] Database connection URL.
#
# LOCAL DEVELOPMENT (SQLite):
#   DATABASE_URL=sqlite:///./blog.db
#
# PRODUCTION / RAILWAY (PostgreSQL):
#   On Railway, add a PostgreSQL service and link it using:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   or the connection string starting with:
#   postgresql://user:password@host:port/database
DATABASE_URL=sqlite:///./blog.db

# [OPTIONAL] Allowed origins for CORS (comma-separated or * for all)
ALLOWED_ORIGINS=*

# [OPTIONAL] Access token expiration time in minutes (default is 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# [OPTIONAL] Google Gemini API Key for AI features (get free at https://aistudio.google.com/app/apikey)
# On Railway, add this in your Service -> Variables tab:
GEMINI_API_KEY=
